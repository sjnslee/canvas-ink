{
  "manifest_version": 3,
  "name": "Canvas Ink",
  "description": "lightweight canvas utilities",
  "version": "0.0.2",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "html/popup.html",
    "default_title": "Canvas Ink",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "html/popup.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["js/defaults.js", "js/content.js"],
      "css": ["css/content.css", "css/theme.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "canvas-ink@sjnslee",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
